{%- liquid
  assign social_names = 'Instagram,TikTok,Pinterest,YouTube,Facebook,X,Snapchat,Tumblr,Vimeo' | split: ','
  assign social_urls = settings.social_instagram_link | append: '|' | append: settings.social_tiktok_link | append: '|' | append: settings.social_pinterest_link | append: '|' | append: settings.social_youtube_link | append: '|' | append: settings.social_facebook_link | append: '|' | append: settings.social_twitter_link | append: '|' | append: settings.social_snapchat_link | append: '|' | append: settings.social_tumblr_link | append: '|' | append: settings.social_vimeo_link | split: '|'
-%}
<footer class="nl-s nl-dark nl-footer">
  <div class="nl-wrap nl-footer__inner">
    <div class="nl-foot">
      <div class="nl-foot__brand">
        {%- if section.settings.use_brand_logo -%}
          {%- assign logo_height = section.settings.logo_width | divided_by: 5.138 | round -%}
          <img
            class="nl-footer__logo-img"
            src="{{ 'nl-logo.svg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
            height="{{ logo_height }}"
            loading="lazy"
          >
        {%- else -%}
          <span class="nl-footer__logo">{{ section.settings.logo_text | default: shop.name | escape }}</span>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="nl-footer__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          <ul class="list-unstyled nl-footer__social" role="list">
            {%- for name in social_names -%}
              {%- assign url = social_urls[forloop.index0] -%}
              {%- if url != blank -%}
                <li><a class="nl-footer__chip" href="{{ url }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">{{ name }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.settings.menu != blank -%}
          <nav class="nl-footer__col{% if block.settings.menu.links.size > 6 %} nl-footer__col--split{% endif %}" aria-label="{{ block.settings.heading | default: block.settings.menu.title | escape }}" {{ block.shopify_attributes }}>
            <h2 class="nl-lbl nl-footer__heading">{{ block.settings.heading | default: block.settings.menu.title | escape }}</h2>
            <ul class="list-unstyled nl-footer__links" role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="nl-footer__bar">
      {%- if section.settings.show_payment -%}
        <ul class="list-unstyled nl-footer__pay" role="list" aria-label="{{ 'nailogy.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {%- case type -%}
              {%- when 'visa' -%}{%- assign pay_name = 'Visa' -%}
              {%- when 'master' -%}{%- assign pay_name = 'Mastercard' -%}
              {%- when 'american_express' -%}{%- assign pay_name = 'American Express' -%}
              {%- when 'apple_pay' -%}{%- assign pay_name = 'Apple Pay' -%}
              {%- when 'google_pay' -%}{%- assign pay_name = 'Google Pay' -%}
              {%- when 'shopify_pay' -%}{%- assign pay_name = 'Shop Pay' -%}
              {%- when 'paypal' -%}{%- assign pay_name = 'PayPal' -%}
              {%- when 'klarna' -%}{%- assign pay_name = 'Klarna' -%}
              {%- when 'afterpay' or 'clearpay' -%}{%- assign pay_name = 'Clearpay' -%}
              {%- when 'maestro' -%}{%- assign pay_name = 'Maestro' -%}
              {%- else -%}{%- assign pay_name = type | replace: '_', ' ' | capitalize -%}
            {%- endcase -%}
            <li class="nl-footer__pay-chip">{{ pay_name }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'NlFooterCurrency', class: 'nl-footer__currency' -%}
          <label for="NlFooterCurrency-select" class="nl-footer__currency-label">{{ 'nailogy.footer.currency' | t }}</label>
          <select id="NlFooterCurrency-select" name="country_code" class="nl-footer__select" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
            {%- assign seen = '' -%}
            {%- for country in localization.available_countries -%}
              {%- assign code = country.currency.iso_code -%}
              {%- assign token = '|' | append: code | append: '|' -%}
              {%- if country.iso_code == localization.country.iso_code -%}
                <option value="{{ country.iso_code }}" selected>{{ code }} {{ country.currency.symbol }}</option>
                {%- assign seen = seen | append: token -%}
              {%- elsif seen contains token or code == localization.country.currency.iso_code -%}
                {%- continue -%}
              {%- else -%}
                <option value="{{ country.iso_code }}">{{ code }} {{ country.currency.symbol }}</option>
                {%- assign seen = seen | append: token -%}
              {%- endif -%}
            {%- endfor -%}
          </select>
          <noscript><button class="nl-btn nl-btn--light nl-btn--small" type="submit">{{ 'nailogy.footer.update' | t }}</button></noscript>
        {%- endform -%}
      {%- endif -%}
    </div>

    <div class="nl-footer__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name | escape }}. {{ section.settings.copyright_suffix | escape }}</span>
      <span class="nl-footer__legal-links">
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%} Theme-built policy pages (templates/index.terms.json, index.refunds.json), hidden once the Shopify policy exists. {%- endcomment -%}
        {%- if shop.terms_of_service == blank -%}
          <a href="{{ routes.root_url }}?view=terms">{{ 'nailogy.footer.terms' | t }}</a>
        {%- endif -%}
        {%- if shop.refund_policy == blank -%}
          <a href="{{ routes.root_url }}?view=refunds">{{ 'nailogy.footer.refunds' | t }}</a>
        {%- endif -%}
        <a href="#" data-nl-cookie-open>Cookie settings</a>
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "NL Footer",
  "class": "nl-footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_brand_logo",
      "label": "Use NAILOGY logo",
      "default": true,
      "info": "Shown in white on the dark footer."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "NAILOGY",
      "info": "Used when the NAILOGY logo is turned off."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Professional nail care, made calm. Designed in the UK."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true,
      "info": "Add links in Theme settings > Social media."
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment methods",
      "default": true,
      "info": "Lists the payment methods enabled in your Shopify payments settings."
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true,
      "info": "Appears when you sell to more than one market."
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "info": "Defaults to your store name."
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright note",
      "default": "All prices include VAT."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu",
      "info": "Leave empty to list your store policies."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Defaults to the menu name."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
