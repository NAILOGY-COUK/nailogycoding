<div class="nl-s nl-wrap nl-sec nl-newsletter">
  <h2 class="nl-h nl-newsletter__heading">{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.text != blank -%}
    <div class="nl-newsletter__text nl-rte">{{ section.settings.text }}</div>
  {%- endif -%}
  <div class="nl-newsletter__form">
    {%- assign form_id = 'NlNewsletter-' | append: section.id -%}
    {%- render 'nl-signup-form',
      form_id: form_id,
      tags: section.settings.tags,
      placeholder: section.settings.placeholder,
      button_label: section.settings.button_label,
      success_text: section.settings.success
    -%}
  </div>
  {%- if section.settings.small_print != blank -%}
    <div class="nl-newsletter__small">{{ section.settings.small_print }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NL Newsletter",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sign-ups are saved as customers who accept email marketing, tagged as below."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New shades, gentle how-tos and early Academy news. Once a fortnight, never more.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "Thank you. Your first email is on its way."
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Customer tags",
      "default": "newsletter"
    },
    {
      "type": "inline_richtext",
      "id": "small_print",
      "label": "Small print",
      "default": "Unsubscribe at any time. See our <a href=\"/policies/privacy-policy\">Privacy Policy</a>."
    }
  ],
  "presets": [
    {
      "name": "NL Newsletter"
    }
  ]
}
{% endschema %}
