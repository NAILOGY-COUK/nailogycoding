<div class="nl-s nl-wrap nl-promo" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.aria_label != blank -%}
    <h2 class="visually-hidden">{{ section.settings.aria_label | escape }}</h2>
  {%- endif -%}
  <div class="nl-g1-3">
    {%- for block in section.blocks -%}
      <a
        class="nl-promo__tile"
        {% if block.settings.link != blank %}
          href="{{ block.settings.link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- case block.settings.art -%}
          {%- when 'bottles' -%}
            <div class="nl-art nl-art--bottles nl-promo__media nl-promo__media--bottles">
              {%- render 'nl-bottle', shade: block.settings.shade_1, width: '18%' -%}
              {%- render 'nl-bottle', shade: block.settings.shade_2, width: '18%' -%}
              {%- render 'nl-bottle', shade: block.settings.shade_3, width: '18%' -%}
            </div>
          {%- when 'dropper' -%}
            <div class="nl-art nl-art--bottles nl-promo__media nl-promo__media--dropper">
              {%- render 'nl-bottle', type: 'dropper', shade: block.settings.shade_1, width: '20%', label_size: 7 -%}
            </div>
          {%- else -%}
            <div class="nl-art nl-promo__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'nl-art__img',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 900px) 33vw, 100vw',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- else -%}
                <img class="nl-art__img" src="{{ 'nl-demo-fur.jpg' | asset_url }}" alt="" width="739" height="415" loading="lazy">
              {%- endif -%}
            </div>
        {%- endcase -%}
        {%- if block.settings.badge != blank -%}
          <span class="nl-badge-soon nl-promo__badge" style="background: {{ block.settings.badge_color }};">
            {{- block.settings.badge | escape -}}
          </span>
        {%- endif -%}

        {%- if block.settings.label != blank -%}
          <span class="nl-lbl{% if block.settings.show_marker %} nl-lbl--marker{% endif %}">
            {%- if block.settings.show_marker -%}
              <span class="nl-marker" style="background: {{ block.settings.marker_color }};" aria-hidden="true"></span>
            {%- endif -%}
            {{- block.settings.label | escape -}}
          </span>
        {%- endif -%}
        <span class="nl-promo__row">
          <span class="nl-h nl-promo__heading">{{ block.settings.heading | escape }}</span>
          {%- if block.settings.link_label != blank -%}
            <span class="nl-tl">{{ block.settings.link_label | escape }}</span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "NL Promo tiles",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section name for screen readers",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bestsellers"
        },
        {
          "type": "checkbox",
          "id": "show_marker",
          "label": "Show label marker",
          "default": false
        },
        {
          "type": "color",
          "id": "marker_color",
          "label": "Marker colour",
          "default": "#8A8666"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Bestselling gel polish"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop"
        },
        {
          "type": "header",
          "content": "Artwork"
        },
        {
          "type": "select",
          "id": "art",
          "label": "Artwork style",
          "default": "bottles",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "bottles", "label": "Bottle trio illustration" },
            { "value": "dropper", "label": "Dropper bottle illustration" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "shade_1",
          "label": "Shade 1",
          "default": "#5E3B2E"
        },
        {
          "type": "color",
          "id": "shade_2",
          "label": "Shade 2",
          "default": "#1C1716"
        },
        {
          "type": "color",
          "id": "shade_3",
          "label": "Shade 3",
          "default": "#B98680"
        },
        {
          "type": "header",
          "content": "Badge"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "info": "E.g. Coming soon. Leave empty to hide."
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge colour",
          "default": "#8A8666"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NL Promo tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
