{%- liquid
  assign bg = section.settings.background | default: settings.nl_color_bone
  assign heading_id = 'NlRoutineHeading-' | append: section.id
-%}
<div class="nl-s nl-routine" style="background: {{ bg }};">
  <div class="nl-wrap nl-sec">
    <div class="nl-head-row nl-routine__head">
      <div class="nl-head-row__titles">
        {%- if section.settings.label != blank -%}
          <span class="nl-lbl">{{ section.settings.label | escape }}</span>
        {%- endif -%}
        <h2 id="{{ heading_id }}" class="nl-h nl-h--section">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="nl-tl" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <ol class="list-unstyled nl-steps" aria-labelledby="{{ heading_id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign number = block.settings.number
          if number == blank
            assign number = forloop.index | prepend: '0' | slice: -2, 2
          endif
        -%}
        <li class="nl-step" {{ block.shopify_attributes }}>
          <span class="nl-step__top">
            <span class="nl-h nl-step__number" aria-hidden="true">{{ number | escape }}</span>
            <span class="nl-step__drop" style="background: {{ block.settings.shade }};" aria-hidden="true"></span>
          </span>
          <h3 class="nl-h nl-step__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="nl-step__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="nl-tl nl-step__link" href="{{ block.settings.link | default: section.settings.link | default: '#' }}">
              {{- block.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "NL Complete routine",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Four steps"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your complete routine"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop the routine"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Leave empty to use Bone from the design tokens."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "Leave empty to number steps automatically (01, 02 …)."
        },
        {
          "type": "color",
          "id": "shade",
          "label": "Shade",
          "default": "#E4DCCB"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Prep"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Push back, buff and cleanse for a clean surface."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop prep"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the section link."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "NL Complete routine",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "shade": "#D8C0A3", "title": "Base", "text": "A thin rubber base for grip and a smooth finish.", "link_label": "Shop base coats" } },
        { "type": "step", "settings": { "shade": "#B98680", "title": "Colour", "text": "Two slim coats of gel colour, cured between each.", "link_label": "Shop gel polish" } },
        { "type": "step", "settings": { "shade": "#5E3B2E", "title": "Top coat & care", "text": "Seal with top coat, then oil daily.", "link_label": "Shop top coats" } }
      ]
    }
  ]
}
{% endschema %}
