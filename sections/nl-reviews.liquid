{%- liquid
  assign bg = section.settings.background | default: settings.nl_color_bone
  assign heading_id = 'NlReviewsHeading-' | append: section.id
  assign rating = section.settings.rating | times: 1.0
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}
<div class="nl-s nl-reviews" style="background: {{ bg }}; --nl-review-star: {{ section.settings.star_color }};">
  <div class="nl-wrap nl-sec">
    <div class="nl-reviews__head">
      {%- if section.settings.label != blank -%}
        <span class="nl-lbl">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      <h2 id="{{ heading_id }}" class="nl-h nl-h--section">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_summary -%}
        <div class="nl-reviews__summary">
          <span class="nl-h nl-reviews__score">{{ section.settings.rating }}</span>
          <span class="nl-reviews__stars">{%- render 'nl-stars', rating: rating, px: 18 -%}</span>
          {%- if section.settings.review_count != blank -%}
            <span class="nl-reviews__count">{{ 'nailogy.reviews.based_on' | t: count: section.settings.review_count }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <span class="nl-reviews__note">{{ section.settings.note | escape }}</span>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="nl-reviews__app">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    {%- if review_blocks.size > 0 -%}
      <div class="nl-g1-3">
        {%- for block in review_blocks -%}
          <figure class="nl-review" {{ block.shopify_attributes }}>
            <span class="nl-review__stars">{%- render 'nl-stars', rating: block.settings.rating, px: 16 -%}</span>
            <blockquote class="nl-h nl-review__quote">“{{ block.settings.quote | escape }}”</blockquote>
            <figcaption class="nl-review__meta">
              <strong>{{ block.settings.name | escape }}</strong>
              {%- if block.settings.product != blank %} · {{ block.settings.product | escape }}{% endif -%}
              {%- if block.settings.date != blank -%}<br>{{ block.settings.date | escape }}{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NL Reviews",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Layout for reviews. Add your reviews app as an app block, then remove the sample review blocks."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved at home"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary",
      "default": true
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Average rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Number of reviews",
      "default": "[review count]"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Sample reviews for layout. Live reviews come from your reviews app."
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Review card star colour",
      "default": "#B9704D"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Leave empty to use Bone from the design tokens."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Three weeks in and not a single chip. The colour is exactly as shown."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Amelia"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Gel Colour in Cocoa"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "12 October 2026"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "NL Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "quote": "The builder gel levels itself. My nails finally feel strong again.", "name": "Priya", "product": "Builder Gel in a Bottle, Milk", "date": "3 October 2026" } },
        { "type": "review", "settings": { "quote": "Calm packaging, clear instructions and the oil smells lovely.", "name": "Hannah", "product": "The Care Ritual", "date": "28 September 2026" } }
      ]
    }
  ]
}
{% endschema %}
