<div
  class="nl-s nl-wrap"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.aria_label != blank -%}
    <h2 class="visually-hidden">{{ section.settings.aria_label | escape }}</h2>
  {%- endif -%}
  <div class="nl-g1-3">
    {%- for block in section.blocks -%}
      {%- liquid
        assign panel_product = block.settings.product
        assign link = block.settings.link | default: panel_product.url
        assign heading = block.settings.heading | default: panel_product.title
      -%}
      <a
        class="nl-panel"
        {% if link != blank %}
          href="{{ link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- case block.settings.art -%}
          {%- when 'bottles' -%}
            <div class="nl-panel__media nl-art--bottles nl-panel__media--bottles" style="background: {{ block.settings.art_background }};">
              {%- render 'nl-bottle', shade: block.settings.shade_1, width: '19%' -%}
              {%- render 'nl-bottle', shade: block.settings.shade_2, width: '22%' -%}
              {%- render 'nl-bottle', shade: block.settings.shade_3, width: '19%' -%}
            </div>
          {%- when 'swatches' -%}
            <div class="nl-panel__media nl-art--swatches nl-panel__media--swatches" aria-hidden="true">
              <span style="background: {{ block.settings.shade_1 }};"></span>
              <span style="background: {{ block.settings.shade_2 }};"></span>
              <span style="background: {{ block.settings.shade_3 }};"></span>
              <span style="background: {{ block.settings.shade_4 }};"></span>
            </div>
          {%- else -%}
            <div class="nl-panel__media">
              {%- liquid
                assign panel_image = block.settings.image | default: panel_product.featured_image
              -%}
              {%- if panel_image != blank -%}
                {%- assign focal_style = panel_image.presentation.focal_point
                  | default: '50% 50%'
                  | prepend: 'object-position: '
                -%}
                {{
                  panel_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'nl-art__img',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 900px) 33vw, 100vw',
                    loading: 'lazy',
                    alt: '',
                    style: focal_style
                }}
              {%- else -%}
                <img
                  class="nl-art__img"
                  src="{{ 'nl-demo-hand.jpg' | asset_url }}"
                  alt=""
                  width="1290"
                  height="1219"
                  loading="lazy"
                  style="object-position: 30% 60%;"
                >
              {%- endif -%}
            </div>
        {%- endcase -%}
        <div class="nl-panel__body">
          {%- if block.settings.label != blank -%}
            <span class="nl-lbl{% if block.settings.show_marker %} nl-lbl--marker{% endif %}">
              {%- if block.settings.show_marker -%}
                <span class="nl-marker" style="background: {{ block.settings.marker_color }};" aria-hidden="true"></span>
              {%- endif -%}
              {{- block.settings.label | escape -}}
            </span>
          {%- endif -%}
          <h3 class="nl-h nl-panel__heading">{{ heading | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="nl-panel__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <span class="nl-tl nl-panel__link">{{ block.settings.link_label | escape }}</span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "NL Feature panels",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section name for screen readers",
      "default": "Featured"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product or bundle",
          "info": "Optional. Fills the link, heading and image when those are empty."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bundle · Save 15%"
        },
        {
          "type": "checkbox",
          "id": "show_marker",
          "label": "Show label marker",
          "default": true
        },
        {
          "type": "color",
          "id": "marker_color",
          "label": "Marker colour",
          "default": "#B9704D"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Builder Gel Kit"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Base, builder and top coat in one box. Everything for a strong, natural-looking set."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "header",
          "content": "Artwork"
        },
        {
          "type": "select",
          "id": "art",
          "label": "Artwork style",
          "default": "bottles",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "bottles", "label": "Bottle trio illustration" },
            { "value": "swatches", "label": "Four colour swatches" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "art_background",
          "label": "Illustration background",
          "default": "#D8C0A3"
        },
        {
          "type": "color",
          "id": "shade_1",
          "label": "Shade 1",
          "default": "#EDE6DD"
        },
        {
          "type": "color",
          "id": "shade_2",
          "label": "Shade 2",
          "default": "#B98680"
        },
        {
          "type": "color",
          "id": "shade_3",
          "label": "Shade 3",
          "default": "#F7F4EE"
        },
        {
          "type": "color",
          "id": "shade_4",
          "label": "Shade 4 (swatches only)",
          "default": "#1C1716"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NL Feature panels",
      "blocks": [{ "type": "panel" }, { "type": "panel" }, { "type": "panel" }]
    }
  ]
}
{% endschema %}
