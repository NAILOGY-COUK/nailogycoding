{%- assign heading_id = 'NlIgHeading-' | append: section.id -%}
<div class="nl-s nl-sec nl-ig-section">
  <div class="nl-wrap nl-head-row">
    <h2 id="{{ heading_id }}" class="nl-h nl-h--section">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.handle != blank -%}
      <a class="nl-tl" href="{{ section.settings.link | default: settings.social_instagram_link }}">{{ section.settings.handle | escape }}</a>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="nl-wrap nl-ig__app">{% render block %}</div>
    {%- endif -%}
  {%- endfor -%}

  {%- assign tiles = section.blocks | where: 'type', 'tile' -%}
  {%- if tiles.size > 0 -%}
    <ul class="list-unstyled nl-ig" role="list" aria-labelledby="{{ heading_id }}">
      {%- for block in tiles -%}
        {%- assign tile_link = block.settings.link | default: section.settings.link | default: settings.social_instagram_link -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="nl-ig__tile"
            {% if tile_link != blank %}
              href="{{ tile_link }}"
            {% endif %}
            aria-label="{{ 'nailogy.instagram.post' | t: index: forloop.index }}"
            style="background: {{ block.settings.color }};"
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  class: 'nl-art__img',
                  widths: '200, 300, 400, 600',
                  sizes: '(min-width: 900px) 17vw, 34vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- elsif block.settings.sample != 'none' -%}
              {%- liquid
                if block.settings.sample == 'nl-demo-hand' or block.settings.sample == 'nl-demo-pink'
                  assign sample_w = 1200
                  assign sample_h = 1600
                else
                  assign sample_w = 1080
                  assign sample_h = 1919
                endif
              -%}
              <img
                class="nl-art__img"
                src="{{ block.settings.sample | append: '.jpg' | asset_url }}"
                alt=""
                width="{{ sample_w }}"
                height="{{ sample_h }}"
                loading="lazy"
                style="object-position: {{ block.settings.sample_position }};"
              >
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NL Instagram grid",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Layout for your feed. Add an Instagram app as an app block, or pick images for each tile."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On the gram"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@nailogy.shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile link",
      "info": "Defaults to the Instagram link in Theme settings > Social media."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Background colour",
          "default": "#E4DCCB"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the profile link."
        },
        {
          "type": "select",
          "id": "sample",
          "label": "Sample image (until you pick one)",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "nl-demo-hand", "label": "Nude manicure" },
            { "value": "nl-demo-fur", "label": "Plum manicure" },
            { "value": "nl-demo-plum", "label": "Plum manicure 2" },
            { "value": "nl-demo-pink", "label": "Pink manicure" }
          ]
        },
        {
          "type": "text",
          "id": "sample_position",
          "label": "Sample image position",
          "default": "50% 50%"
        }
      ]
    }
  ],
  "max_blocks": 13,
  "presets": [
    {
      "name": "NL Instagram grid",
      "blocks": [
        { "type": "tile", "settings": { "sample": "nl-demo-hand" } },
        { "type": "tile", "settings": { "color": "#B98680" } },
        { "type": "tile", "settings": { "color": "#5E3B2E" } },
        { "type": "tile", "settings": { "sample": "nl-demo-fur" } },
        { "type": "tile", "settings": { "sample": "nl-demo-plum" } },
        { "type": "tile", "settings": { "color": "#C08A6B" } }
      ]
    }
  ]
}
{% endschema %}
