{%- assign icon_color = section.settings.icon_color | default: settings.nl_color_olive -%}
<div class="nl-s nl-wrap" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.aria_label != blank -%}
    <h2 class="visually-hidden">{{ section.settings.aria_label | escape }}</h2>
  {%- endif -%}
  {%- render 'nl-icon-row', blocks: section.blocks, variant: 'benefits', icon_color: icon_color -%}
</div>

{% schema %}
{
  "name": "NL Benefit icons",
  "tag": "section",
  "class": "nl-section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section name for screen readers",
      "default": "Why NAILOGY"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "info": "Leave empty to use Dusty Olive from the design tokens."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf (vegan)"
            },
            {
              "value": "clock",
              "label": "Clock (long-wear)"
            },
            {
              "value": "shield",
              "label": "Shield (safe formula)"
            },
            {
              "value": "spark",
              "label": "Spark (quality)"
            },
            {
              "value": "truck",
              "label": "Delivery van"
            },
            {
              "value": "box",
              "label": "Parcel"
            },
            {
              "value": "return",
              "label": "Return arrow"
            },
            {
              "value": "lock",
              "label": "Padlock"
            },
            {
              "value": "check",
              "label": "Tick"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above. Use a square SVG or PNG."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Vegan"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No animal-derived ingredients"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "NL Benefit icons",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "leaf",
            "title": "Vegan",
            "text": "No animal-derived ingredients"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "clock",
            "title": "Long-wear",
            "text": "Up to 21 days of colour"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "HEMA-free",
            "text": "Kinder to nails and skin"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "spark",
            "title": "Salon-quality",
            "text": "Professional formulas at home"
          }
        }
      ]
    }
  ]
}
{% endschema %}
