{% comment %}
  Free delivery progress bar for the basket. Threshold: Theme settings > Cart > Free delivery threshold.
  Only shown when the shopper browses in the store currency, because Liquid has no exchange rate.

  Usage:
  {% render 'nl-free-delivery' %}
{% endcomment %}
{%- liquid
  assign threshold = settings.nl_free_delivery_threshold | default: 0 | times: 1
  assign show_bar = false
  if settings.nl_free_delivery_enabled and threshold > 0 and cart.currency.iso_code == shop.currency
    assign show_bar = true
  endif
-%}
{%- if show_bar -%}
  {%- liquid
    assign threshold_cents = threshold | times: 100
    assign total = cart.total_price
    assign remaining = threshold_cents | minus: total
    assign percent = total | times: 100 | divided_by: threshold_cents | at_most: 100 | at_least: 0
    assign now_value = total | divided_by: 100.0 | at_most: threshold
  -%}
  <div class="nl-basket__progress">
    <p class="nl-basket__progress-msg" role="status">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{- 'nailogy.basket.remaining_html' | t: amount: remaining_money -}}
      {%- else -%}
        {{- 'nailogy.basket.unlocked' | t -}}
      {%- endif -%}
    </p>
    <div
      class="nl-basket__bar"
      role="progressbar"
      aria-label="{{ 'nailogy.basket.progress_label' | t }}"
      aria-valuemin="0"
      aria-valuemax="{{ threshold }}"
      aria-valuenow="{{ now_value }}"
    >
      <span class="nl-basket__bar-fill" style="width: {{ percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
