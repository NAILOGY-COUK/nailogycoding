{% comment %}
  Renders a NAILOGY line icon (24px grid, square caps), taken from the brand design.

  Accepts:
  - icon: {String} Icon name (required): menu, search, account, basket, close, arrow-left, arrow-right,
    play, star, check, leaf, clock, shield, spark, truck, box, return, lock, none
  - px: {Number} Width and height in px. Default: 22
  - stroke: {Number} Stroke width. Default: 1.5
  - class: {String} Extra classes (optional)

  Usage:
  {% render 'nl-icon', icon: 'search' %}
{% endcomment %}
{%- liquid
  assign px = px | default: 22
  assign stroke = stroke | default: 1.5
  assign filled = false
  case icon
    when 'menu'
      assign d = 'M4 7h16M4 12h16M4 17h16'
    when 'search'
      assign d = 'M17.5 11a6.5 6.5 0 1 1-13 0a6.5 6.5 0 1 1 13 0M16 16l4.5 4.5'
    when 'account'
      assign d = 'M15.75 8.5a3.75 3.75 0 1 1-7.5 0a3.75 3.75 0 1 1 7.5 0M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5'
    when 'basket'
      assign d = 'M5 8h14l-1 12H6L5 8zM9 8V6.5a3 3 0 0 1 6 0V8'
    when 'close'
      assign d = 'M6 6l12 12M18 6L6 18'
    when 'arrow-left'
      assign d = 'M19 12H5M11 6l-6 6 6 6'
    when 'arrow-right'
      assign d = 'M5 12h14M13 6l6 6-6 6'
    when 'check'
      assign d = 'M5 12.5l4.5 4.5L19 7.5'
    when 'leaf'
      assign d = 'M5 19c0-8 5-13 14-14 0 9-5 14-13 14M5 19l7-7'
    when 'clock'
      assign d = 'M20 12a8 8 0 1 1-16 0a8 8 0 1 1 16 0M12 7.5V12l3 2'
    when 'shield'
      assign d = 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3zM9 12l2 2 4-4'
    when 'spark'
      assign d = 'M12 3v5M12 16v5M3 12h5M16 12h5M6.5 6.5l2.5 2.5M15 15l2.5 2.5M17.5 6.5L15 9M9 15l-2.5 2.5'
    when 'truck'
      assign d = 'M3 6h11v10H3zM14 9h4l3 3v4h-7M8.5 17.5a1.5 1.5 0 1 1-3 0a1.5 1.5 0 1 1 3 0M18.5 17.5a1.5 1.5 0 1 1-3 0a1.5 1.5 0 1 1 3 0'
    when 'box'
      assign d = 'M4 7.5L12 4l8 3.5v9L12 20l-8-3.5zM4 7.5l8 3.5 8-3.5M12 11v9'
    when 'return'
      assign d = 'M4 9h11a5 5 0 0 1 0 10H9M8 5L4 9l4 4'
    when 'lock'
      assign d = 'M5 10.5h14V20H5zM8 10.5V8a4 4 0 0 1 8 0v2.5'
    when 'play'
      assign d = 'M8 5v14l11-7z'
      assign filled = true
    when 'play-small'
      assign d = 'M6 3v18l15-9z'
      assign filled = true
    when 'star'
      assign d = 'M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z'
      assign filled = true
  endcase
-%}
{%- if d != blank -%}
  {%- if filled -%}
    <svg class="nl-icon {{ class }}" width="{{ px }}" height="{{ px }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ d }}" fill="currentColor"{% if opacity %} opacity="{{ opacity }}"{% endif %}></path></svg>
  {%- else -%}
    <svg class="nl-icon {{ class }}" width="{{ px }}" height="{{ px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="square"{% if linejoin %} stroke-linejoin="round"{% endif %} aria-hidden="true" focusable="false"><path d="{{ d }}"></path></svg>
  {%- endif -%}
{%- endif -%}
